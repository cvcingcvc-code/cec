# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/

# PHASE 5 — retrieval metadata cache.
# Holds parsed page metadata and resolved image URLs so a refresh does not
# re-fetch every event page. It is a CACHE: safe to delete at any time.
pipeline/data/cache/

# PHASE 2 — SQLite primary event store. Machine-local runtime state: every
# crawl upserts into it and apply_lifecycle marks rows in place. The JSON
# exports under pipeline/data/crawl/ are the canonical per-run record and
# stay tracked; the DB is reproducible at any time via
#     python -m pipeline.store.import_json --events pipeline/data/crawl/douban_events.json
pipeline/data/gorgon.db

# Local search configuration. NEVER commit API keys.
.env
.env.local
search.env

# PHASE 8 — Windows desktop build outputs.
# `release/Gorgon-Workbench-Windows/` holds the packaged app (a ~50 MB onedir
# bundle). It is a BUILD ARTIFACT, reproducible at any time with:
#     powershell -ExecutionPolicy Bypass -File desktop/build.ps1
# Committing a frozen Python runtime to git would bloat the repo with no
# benefit, so the bundle is produced on demand and shipped out-of-band.
# The release DOCUMENTS next to it stay tracked — they describe the deliverable.
release/*
!release/*.md
build/

# Per-machine desktop self-test report (written next to the built exe).
desktop-selftest.json

# Transient E2E logs / scratch artifacts.
app/tests/.e2e-logs/
*.log

# Android release signing. The keystore and its credentials are MACHINE+USER
# specific and must NEVER enter the repo — losing the keystore means the
# installed release app can never be upgraded in place. A template
# (keystore.properties.example) documents the expected shape.
app/android/keystore.properties
app/android/app/*.keystore
app/android/app/*.jks

# V2.2 UI before/after evidence: the BEFORE APK is a 3.7MB binary that is
# rebuildable from commit 9f05f9d; only its SHA256 is recorded in
# docs/screenshots/ui-v22-touch/README.md.
docs/screenshots/ui-v22-touch/BEFORE-app-release.apk

# V3 Phase A (Task #3): agent gateway runtime state — pairing token, audit
# log, run records. Machine-local and SECRET (token grants executor access).
# Only the gateway script itself is committed.
scripts/.agent-gateway/

# Isolated runtime diagnostics, test state and dependency cache.
/work/
app/android/local.properties
